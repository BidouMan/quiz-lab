        {
          "id": "3A-U5|word|L2#1",
          "kind": "word",
          "text": "合唱队要在 13 时 55 分前到音乐厅，路上要走 20 分钟。最迟几时几分出发？",
          "workLines": 4,
          "answers": [
            "13 时",
            "35 分"
          ],
          "solution": [
            "hourOf(13 × 60 + 55 - 20) = 13（时）",
            "minuteOf(13 × 60 + 55 - 20) = 35（分）"
          ]
        }
